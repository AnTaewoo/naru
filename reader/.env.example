# cp .env.example .env  — .env는 git에 올리지 않는다. Claude Code는 .env를 읽지 못하게 막혀 있다(.claude/settings.json).

# ── 수집 (R0.3에서 API마다 실제 호출 1회로 확인) ─────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 발급된 키 종류에 맞는 쪽 하나 (R0.3 질문)
#   https://openapi.naver.com/v1/search/news.json        헤더 X-Naver-Client-Id / X-Naver-Client-Secret
#   https://naverapihub.apigw.ntruss.com/search/v1/news   헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_NEWS_ENDPOINT=
SEOUL_OPENDATA_KEY=
KAKAO_REST_KEY=

# ── 비교 실험 exp004 ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 로컬 모델 exp005 (gated 모델일 때만) ───────────────────────────
HF_TOKEN=

# ── 라벨링 (R0.4, R3) ─────────────────────────────────────────────
# Docker Hub heartexlabs/label-studio 의 태그 하나. latest 금지 — 비어 있으면 docker compose가 멈춘다
LABEL_STUDIO_VERSION=
LABEL_STUDIO_URL=http://localhost:8080
# Label Studio 계정 설정의 토큰 (토큰 방식은 설치한 버전 문서로 R0.4에서 확인)
LABEL_STUDIO_API_KEY=
# 라벨을 인정할 주석자 이메일, 쉼표로 구분. 여기 없는 사람의 라벨은 export에서 거부된다
ANNOTATORS=
