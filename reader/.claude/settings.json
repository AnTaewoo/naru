{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",

      "Read(/data/interim/*/sealed/**)",
      "Read(/data/splits/*/sealed/**)",
      "Read(/experiments/*/predictions_test*)",
      "Read(/experiments/*/errors_test*)",

      "Edit(/data/raw/**)",
      "Edit(/data/recorded/**)",
      "Edit(/data/labeled/**)",
      "Edit(/data/interim/**)",
      "Edit(/data/splits/**)",
      "Edit(/data/gazetteer/**)",
      "Edit(/labeling/format_probe/**)",

      "Edit(/results.csv)",
      "Edit(/experiments/*/run.json)",
      "Edit(/experiments/*/metrics_*.json)",
      "Edit(/experiments/*/FROZEN.json)",
      "Edit(/experiments/*/test_log.jsonl)",

      "Edit(/.claude/settings.json)",
      "Edit(/scripts/check_no_fakes.sh)",
      "Edit(/.importlinter)"
    ]
  }
}
