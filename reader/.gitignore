# 비밀
.env

# 파이썬
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Claude Code 개인 설정 (공용 규칙은 .claude/settings.json — 커밋한다)
.claude/settings.local.json

# 실데이터 — git에 올리지 않는다 (CLAUDE.md §4). MANIFEST와 .gitkeep만
data/raw/*
data/interim/*
data/labeled/*
data/splits/*
data/recorded/*
data/gazetteer/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/labeled/.gitkeep
!data/splits/.gitkeep
!data/recorded/.gitkeep
!data/gazetteer/.gitkeep

# Label Studio 서버 데이터·export 원본 (따로 비공개 백업)
labeling/ls-data/
labeling/format_probe/

# 실험 산출물 중 크거나 문장이 들어간 것 (run·metrics·FROZEN·test_log·config는 커밋한다)
experiments/*/checkpoints/
experiments/*/predictions_*.jsonl
experiments/*/errors_*.jsonl

# 문장이 들어갈 수 있는 지도·HTML
reports/*.html
