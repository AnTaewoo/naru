{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naru_contracts",
  "title": "NaruContracts",
  "description": "docs/INTERFACE.md v0.5 — scripts/export_schema.py 생성물. 수정 금지",
  "type": "object",
  "properties": {
    "CandidateSummary": {
      "$ref": "#/$defs/CandidateSummary"
    },
    "ClosureType": {
      "$ref": "#/$defs/ClosureType"
    },
    "Evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "EvidenceKind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "Impact": {
      "$ref": "#/$defs/Impact"
    },
    "LineGeom": {
      "$ref": "#/$defs/LineGeom"
    },
    "NoticeRef": {
      "$ref": "#/$defs/NoticeRef"
    },
    "PlacePoint": {
      "$ref": "#/$defs/PlacePoint"
    },
    "PointGeom": {
      "$ref": "#/$defs/PointGeom"
    },
    "RoadClass": {
      "$ref": "#/$defs/RoadClass"
    },
    "SegmentGeom": {
      "$ref": "#/$defs/SegmentGeom"
    },
    "Source": {
      "$ref": "#/$defs/Source"
    },
    "Status": {
      "$ref": "#/$defs/Status"
    },
    "SummarySegment": {
      "$ref": "#/$defs/SummarySegment"
    },
    "Window": {
      "$ref": "#/$defs/Window"
    },
    "ZoneGeom": {
      "$ref": "#/$defs/ZoneGeom"
    },
    "ClosureCandidate": {
      "$ref": "#/$defs/ClosureCandidate"
    },
    "CandidateBatch": {
      "$ref": "#/$defs/CandidateBatch"
    },
    "CandidateBatchResponse": {
      "$ref": "#/$defs/CandidateBatchResponse"
    },
    "ClosureState": {
      "$ref": "#/$defs/ClosureState"
    },
    "RouteQuery": {
      "$ref": "#/$defs/RouteQuery"
    },
    "Avoided": {
      "$ref": "#/$defs/Avoided"
    },
    "Baseline": {
      "$ref": "#/$defs/Baseline"
    },
    "Leg": {
      "$ref": "#/$defs/Leg"
    },
    "LegKind": {
      "$ref": "#/$defs/LegKind"
    },
    "LineString": {
      "$ref": "#/$defs/LineString"
    },
    "RouteResponse": {
      "$ref": "#/$defs/RouteResponse"
    },
    "ClosuresQuery": {
      "$ref": "#/$defs/ClosuresQuery"
    },
    "Feature": {
      "$ref": "#/$defs/Feature"
    },
    "FeatureProperties": {
      "$ref": "#/$defs/FeatureProperties"
    },
    "PointGeometry": {
      "$ref": "#/$defs/PointGeometry"
    },
    "PolygonGeometry": {
      "$ref": "#/$defs/PolygonGeometry"
    },
    "FeatureCollection": {
      "$ref": "#/$defs/FeatureCollection"
    },
    "ClosureEventsQuery": {
      "$ref": "#/$defs/ClosureEventsQuery"
    },
    "ClosureEvent": {
      "$ref": "#/$defs/ClosureEvent"
    },
    "DataAsOf": {
      "$ref": "#/$defs/DataAsOf"
    },
    "ClosureEventsResponse": {
      "$ref": "#/$defs/ClosureEventsResponse"
    },
    "GeocodeSearchQuery": {
      "$ref": "#/$defs/GeocodeSearchQuery"
    },
    "Place": {
      "$ref": "#/$defs/Place"
    },
    "GeocodeSearchResponse": {
      "$ref": "#/$defs/GeocodeSearchResponse"
    },
    "GeocodeReverseQuery": {
      "$ref": "#/$defs/GeocodeReverseQuery"
    },
    "GeocodeReverseResponse": {
      "$ref": "#/$defs/GeocodeReverseResponse"
    },
    "ErrorDetail": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "ErrorBody": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "$defs": {
    "CandidateSummary": {
      "additionalProperties": false,
      "description": "공지 item 의 구조화 칸 (v0.12, ADR-012). 문장은 없다 — 화면 문장은 FE i18n 이 만든다.",
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/SummarySegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "points": {
          "items": {
            "type": "string"
          },
          "title": "Points",
          "type": "array"
        },
        "reported_people": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported People"
        },
        "roads": {
          "items": {
            "type": "string"
          },
          "title": "Roads",
          "type": "array"
        }
      },
      "title": "CandidateSummary",
      "type": "object"
    },
    "ClosureType": {
      "enum": [
        "marathon",
        "march",
        "rally",
        "event",
        "incident"
      ],
      "title": "ClosureType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "kind",
        "ref",
        "at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "notice",
        "timetable",
        "topis_incident",
        "bus_skip",
        "bus_return",
        "rtd_spike"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Impact": {
      "description": "횡단보도 통행을 막는 재료인가 (ADR-008). 파서의 none 은 BE로 오지 않는다.",
      "enum": [
        "blocks",
        "unknown"
      ],
      "title": "Impact",
      "type": "string"
    },
    "LineGeom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "line",
          "default": "line",
          "title": "Kind",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineGeom",
      "type": "object"
    },
    "NoticeRef": {
      "additionalProperties": false,
      "properties": {
        "notice_id": {
          "title": "Notice Id",
          "type": "string"
        },
        "sentence_id": {
          "title": "Sentence Id",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "notice_id",
        "sentence_id",
        "source_url",
        "published_at",
        "excerpt"
      ],
      "title": "NoticeRef",
      "type": "object"
    },
    "PlacePoint": {
      "additionalProperties": false,
      "description": "리졸버가 정규형을 좌표로 바꾼 결과. 모델(Claude)이 만든 좌표는 여기 들어올 수 없다.",
      "properties": {
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "lng": {
          "title": "Lng",
          "type": "number"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "gazetteer_source": {
          "title": "Gazetteer Source",
          "type": "string"
        },
        "gazetteer_id": {
          "title": "Gazetteer Id",
          "type": "string"
        }
      },
      "required": [
        "canonical",
        "lng",
        "lat",
        "gazetteer_source",
        "gazetteer_id"
      ],
      "title": "PlacePoint",
      "type": "object"
    },
    "PointGeom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "point",
          "default": "point",
          "title": "Kind",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "PointGeom",
      "type": "object"
    },
    "RoadClass": {
      "description": "도로명 접미사. BE가 버퍼 폭을 고른다 (대로 25m / 로 15m / 길 8m — naru_be/config.py).",
      "enum": [
        "대로",
        "로",
        "길"
      ],
      "title": "RoadClass",
      "type": "string"
    },
    "SegmentGeom": {
      "additionalProperties": false,
      "description": "구간. 선은 BE CrosswalkIndex.from_segment가 도로 그래프 최단경로로 만든다.",
      "properties": {
        "kind": {
          "const": "segment",
          "default": "segment",
          "title": "Kind",
          "type": "string"
        },
        "from_": {
          "$ref": "#/$defs/PlacePoint"
        },
        "to": {
          "$ref": "#/$defs/PlacePoint"
        },
        "via": {
          "items": {
            "$ref": "#/$defs/PlacePoint"
          },
          "title": "Via",
          "type": "array"
        },
        "road": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Road"
        },
        "road_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoadClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "from_",
        "to"
      ],
      "title": "SegmentGeom",
      "type": "object"
    },
    "Source": {
      "enum": [
        "course",
        "smpa",
        "topis",
        "news",
        "seoul_press",
        "incident",
        "bus",
        "rtd"
      ],
      "title": "Source",
      "type": "string"
    },
    "Status": {
      "enum": [
        "scheduled",
        "confirmed",
        "released",
        "zone_scheduled"
      ],
      "title": "Status",
      "type": "string"
    },
    "SummarySegment": {
      "additionalProperties": false,
      "description": "공지 구간 이름 (v0.12, ADR-012) — 파서 spans 정규 이름 그대로, 좌표가 안 풀려도 남는다.",
      "properties": {
        "from_": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "via": {
          "items": {
            "type": "string"
          },
          "title": "Via",
          "type": "array"
        }
      },
      "required": [
        "from_",
        "to"
      ],
      "title": "SummarySegment",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "title": "Window",
      "type": "object"
    },
    "ZoneGeom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "zone",
          "default": "zone",
          "title": "Kind",
          "type": "string"
        },
        "zone_name": {
          "title": "Zone Name",
          "type": "string"
        },
        "polygon": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "zone_name",
        "polygon"
      ],
      "title": "ZoneGeom",
      "type": "object"
    },
    "ClosureCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "type": {
          "$ref": "#/$defs/ClosureType"
        },
        "status_hint": {
          "$ref": "#/$defs/Status"
        },
        "impact": {
          "$ref": "#/$defs/Impact"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "line": "#/$defs/LineGeom",
              "point": "#/$defs/PointGeom",
              "segment": "#/$defs/SegmentGeom",
              "zone": "#/$defs/ZoneGeom"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PointGeom"
            },
            {
              "$ref": "#/$defs/LineGeom"
            },
            {
              "$ref": "#/$defs/SegmentGeom"
            },
            {
              "$ref": "#/$defs/ZoneGeom"
            }
          ],
          "title": "Geometry"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "notice_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoticeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "toward": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toward"
        },
        "approx": {
          "default": false,
          "title": "Approx",
          "type": "boolean"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate_id",
        "source",
        "type",
        "status_hint",
        "impact",
        "geometry",
        "window",
        "confidence",
        "evidence"
      ],
      "title": "ClosureCandidate",
      "type": "object"
    },
    "CandidateBatch": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ClosureCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "batch_id",
        "produced_at",
        "producer",
        "candidates"
      ],
      "title": "CandidateBatch",
      "type": "object"
    },
    "CandidateBatchResponse": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "review_required": {
          "title": "Review Required",
          "type": "integer"
        },
        "crosswalks_updated": {
          "title": "Crosswalks Updated",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "accepted",
        "review_required",
        "crosswalks_updated"
      ],
      "title": "CandidateBatchResponse",
      "type": "object"
    },
    "ClosureState": {
      "additionalProperties": false,
      "description": "횡단보도 하나의 현재 상태. BE Repository 결과이자 /closures Feature properties.",
      "properties": {
        "crosswalk_id": {
          "title": "Crosswalk Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "lng": {
          "title": "Lng",
          "type": "number"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "impact": {
          "$ref": "#/$defs/Impact",
          "default": "blocks"
        },
        "approx": {
          "default": false,
          "title": "Approx",
          "type": "boolean"
        }
      },
      "required": [
        "crosswalk_id",
        "status",
        "confidence",
        "window",
        "reason",
        "evidence",
        "lng",
        "lat"
      ],
      "title": "ClosureState",
      "type": "object"
    },
    "RouteQuery": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "depart_at": {
          "format": "date-time",
          "title": "Depart At",
          "type": "string"
        },
        "mode": {
          "default": "walk",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "depart_at"
      ],
      "title": "RouteQuery",
      "type": "object"
    },
    "Avoided": {
      "additionalProperties": false,
      "properties": {
        "crosswalk_id": {
          "title": "Crosswalk Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "approx": {
          "default": false,
          "title": "Approx",
          "type": "boolean"
        }
      },
      "required": [
        "crosswalk_id",
        "status",
        "reason",
        "evidence"
      ],
      "title": "Avoided",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "$ref": "#/$defs/LineString"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "distance_m": {
          "title": "Distance M",
          "type": "number"
        }
      },
      "required": [
        "route",
        "duration_s",
        "distance_m"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Leg": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/LegKind"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "distance_m": {
          "title": "Distance M",
          "type": "number"
        },
        "coord_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Coord Range",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "distance_m",
        "coord_range"
      ],
      "title": "Leg",
      "type": "object"
    },
    "LegKind": {
      "enum": [
        "sidewalk",
        "crosswalk",
        "underpass",
        "overpass",
        "stairs",
        "elevator",
        "station"
      ],
      "title": "LegKind",
      "type": "string"
    },
    "LineString": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
