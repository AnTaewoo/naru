# Naru AI 워커 (T6.1) — naru.service(make serve)와 따로 돈다. 설치:
#   sudo cp deploy/naru-worker.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now naru-worker && journalctl -u naru-worker -f
# 키·토큰은 .env (SEOUL_OPENDATA_KEY, DATA_GO_KR_KEY, NARU_INTERNAL_TOKEN — BE 와 같은 값).
# 노선 경로(getRoutePath)를 다른 키로 받으면 DATA_GO_KR_ROUTE_KEY.
# --live(T6.4): 기록 없는 TOPIS 공지 글을 Claude 로 — ANTHROPIC_API_KEY, 한 번 10·하루 NARU_LLM_DAILY_CAP(200)
# 경찰청 '오늘의 주요집회' PDF(T6.6): data/raw/notices/smpa/inbox/ 에 넣으면 1분 안에 읽어 보내고
#   data/raw/notices/smpa/<집회 날짜>.pdf 로 옮긴다(처리 기록 inbox_manifest.jsonl, 읽을 수 없으면 inbox/failed/)
[Unit]
Description=Naru AI worker (--loop --live: course once, notices/TOPIS incidents 5 min, TOPIS notice posts 10 min, TOPIS control map 10 min, buses 60 s record-only)
After=network-online.target naru.service
Wants=network-online.target

[Service]
Type=simple
User=antaewoo
Group=antaewoo
WorkingDirectory=/home/antaewoo/workspace/naru
Environment=HOME=/home/antaewoo
Environment=PATH=/home/antaewoo/miniconda3/bin:/home/antaewoo/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NARU_BE_URL=http://127.0.0.1:5050
Environment=NARU_INCIDENT_SOURCE=live
Environment=NARU_BUS_SOURCE=live
Environment=NARU_TOPIS_SOURCE=live
# TOPIS 교통통제 지도 예정 통제(T7.3) — 웹 AJAX, 같은 곳 10분에 요청 하나(ADR-011 E)
Environment=NARU_TOPIS_MAP_SOURCE=live
# 버스는 전면 통제·마라톤 창만, 기록만(BE 로 안 보냄) — ADR-013 보류(2026-11-09)
Environment=NARU_BUS_RECORD_ONLY=1
ExecStart=/home/antaewoo/miniconda3/bin/uv run python -m naru_ai.worker --loop --live
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
